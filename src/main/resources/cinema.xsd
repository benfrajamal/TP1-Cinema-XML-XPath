<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!-- Element racine -->
    <xs:element name="cinema">
        <xs:complexType>
            <xs:sequence>

                <!-- Films -->
                <xs:element name="films">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="film"
                                        minOccurs="1"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="titre"
                                                    type="xs:string"/>
                                        <xs:element name="realisateur"
                                                    type="xs:string"/>
                                        <xs:element name="duree"
                                                    type="xs:positiveInteger"/>
                                    </xs:sequence>

                                    <xs:attribute name="id"
                                                  type="xs:ID"
                                                  use="required"/>

                                    <xs:attribute name="genre"
                                                  type="xs:string"
                                                  use="required"/>

                                    <xs:attribute name="annee"
                                                  type="xs:positiveInteger"
                                                  use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- Spectateurs -->
                <xs:element name="spectateurs">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="spectateur"
                                        minOccurs="1"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nom"
                                                    type="xs:string"/>
                                        <xs:element name="email"
                                                    type="xs:string"/>
                                    </xs:sequence>

                                    <xs:attribute name="id"
                                                  type="xs:ID"
                                                  use="required"/>

                                    <xs:attribute name="actif"
                                                  type="xs:boolean"
                                                  use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- Seances -->
                <xs:element name="seances">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="seance"
                                        minOccurs="1"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="salle"
                                                    type="xs:positiveInteger"/>
                                        <xs:element name="duree"
                                                    type="xs:positiveInteger"/>
                                        <xs:element name="date"
                                                    type="xs:date"/>
                                        <xs:element name="heure"
                                                    type="xs:time"/>
                                    </xs:sequence>

                                    <xs:attribute name="id"
                                                  type="xs:ID"
                                                  use="required"/>

                                    <xs:attribute name="film"
                                                  type="xs:IDREF"
                                                  use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>